{
  "name": "pico-piano-synth",
  "version": "0.4.0",
  "description": "Tiny PeriodicWave piano synth with neural network model for Web Audio API.",
  "main": "dist/piano-synth-embedded.min.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "node scripts/prepare-dist.js && npm run build:lib && npm run build:model && node scripts/copy-model.js && npm run build:embedded",
    "build:lib": "terser src/piano-synth.js -c -m --keep-classnames --keep-fnames -o dist/piano-synth.min.js",
    "build:model": "terser model/piano_nn_bin.js -c -m -o dist/piano_nn_bin.min.js",
    "build:embedded": "node scripts/build-embedded.js",
    "build:pages": "webpack --config webpack.pages.config.js"
  },
  "devDependencies": {
    "html-webpack-plugin": "^5.6.8",
    "terser": "^5.31.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "files": [
    "src",
    "model",
    "dist"
  ],
  "keywords": [
    "piano",
    "synth",
    "web-audio",
    "periodicwave",
    "ddsp"
  ],
  "license": "MIT"
}
